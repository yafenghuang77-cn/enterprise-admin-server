# 本地开发环境（NODE_ENV=development）
# 可用 .env.development.local 覆盖个人差异（不入库）
# 校验规则见 src/config/env.schema.ts

# ── 应用 ──────────────────────────────
# 运行环境，须与文件名一致：development
NODE_ENV=development
# HTTP 监听端口
PORT=3000
# 监听地址；本机调试可用 0.0.0.0
HOST=0.0.0.0
# 日志级别：error / warn / info / debug；本地建议 debug
LOG_LEVEL=debug

# ── MySQL（TypeORM）──────────────────
# 数据库主机
DB_HOST=127.0.0.1
# 数据库端口
DB_PORT=3306
# 数据库用户名
DB_USERNAME=root
# 数据库密码
DB_PASSWORD=
# 库名
DB_DATABASE=enterprise_admin
# 连接池大小
DB_POOL_SIZE=10
# TypeORM synchronize 自动建表；仅本地按需开 true
DB_SYNC=false
# 是否打印 SQL 日志
DB_LOGGING=false

# ── Redis ────────────────────────────
# Redis 主机
REDIS_HOST=127.0.0.1
# Redis 端口
REDIS_PORT=6379
# Redis 密码，无则留空
REDIS_PASSWORD=
# Redis 逻辑库编号
REDIS_DB=0
# cache key 前缀，多服务共用 Redis 时防撞键
REDIS_PREFIX=eas:

# ── MongoDB（LangGraph checkpoint）──
# 未启用 AI Agent 时可省略；启用后提供 mongodb:// 或 mongodb+srv:// 连接串
# MONGODB_URI=mongodb://127.0.0.1:27017/eas_checkpoints

# ── 认证 ─────────────────────────────
# JWT 签名密钥；本地用固定开发值即可，禁止用于预发/生产
JWT_SECRET=local-dev-only-jwt-secret-not-for-production
# Access Token 有效期
JWT_EXPIRES_IN=2h
# Refresh Token 有效期
JWT_REFRESH_EXPIRES_IN=7d

# ── LLM ──────────────────────────────
# DeepSeek API Key；开启 FEATURE_AI_AGENT 时至少与 OpenAI 配置一个
DEEPSEEK_API_KEY=
# DeepSeek 模型名
DEEPSEEK_MODEL=deepseek-chat
# OpenAI（或兼容中转）API Key
OPENAI_API_KEY=
# OpenAI 兼容网关地址（可选，走中转时填写）
# OPENAI_BASE_URL=
# OpenAI 模型名
OPENAI_MODEL=gpt-4o-mini

# ── MQ ───────────────────────────────
# 消息驱动：none=不启用 / rabbitmq / kafka；本地默认 none，免装中间件
MQ_DRIVER=none
# MQ_DRIVER=rabbitmq 时必填，如 amqp://user:pass@127.0.0.1:5672
RABBITMQ_URL=
# MQ_DRIVER=kafka 时必填，逗号分隔 broker，如 127.0.0.1:9092
KAFKA_BROKERS=
# Kafka 客户端 ID
KAFKA_CLIENT_ID=enterprise-admin
# Kafka 消费组 ID
KAFKA_GROUP_ID=eas-admin

# ── 功能开关 ─────────────────────────
# AI Agent；false 时不注册相关模块，本地无需 LLM Key
FEATURE_AI_AGENT=false
# 审计日志
FEATURE_AUDIT_LOG=true
