# 预发环境（NODE_ENV=staging）
# 密钥类占位值必须替换；也可在部署平台用同名环境变量覆盖（进程环境优先）
# staging 与 production 同等校验：禁止 DB_SYNC，JWT_SECRET 须 ≥32 且不可为 change-me
# 校验规则见 src/config/env.schema.ts

# ── 应用 ──────────────────────────────
# 运行环境，须与文件名一致：staging
NODE_ENV=staging
# HTTP 监听端口
PORT=3000
# 监听地址；容器/虚拟机内用 0.0.0.0
HOST=0.0.0.0
# 日志级别
LOG_LEVEL=info

# ── MySQL（TypeORM）──────────────────
# 预发库主机（必填，部署时注入）
DB_HOST=
# 预发库端口
DB_PORT=3306
# 预发库用户名（必填，部署时注入）
DB_USERNAME=
# 预发库密码（部署时注入，勿写入仓库）
DB_PASSWORD=
# 预发库名
DB_DATABASE=enterprise_admin
# 连接池大小
DB_POOL_SIZE=10
# 预发禁止 synchronize，结构变更走迁移
DB_SYNC=false
# 是否打印 SQL
DB_LOGGING=false

# ── Redis ────────────────────────────
# Redis 主机（必填，部署时注入）
REDIS_HOST=
# Redis 端口
REDIS_PORT=6379
# Redis 密码（部署时注入）
REDIS_PASSWORD=
# Redis 逻辑库编号
REDIS_DB=0
# cache key 前缀
REDIS_PREFIX=eas:

# ── MongoDB（LangGraph checkpoint）──
# 启用 AI Agent 时提供；否则省略
# MONGODB_URI=

# ── 认证 ─────────────────────────────
# JWT 密钥：须 ≥32 字符且不可为 change-me（部署时替换）
JWT_SECRET=replace-me-staging-jwt-secret-at-least-32-chars
# Access Token 有效期
JWT_EXPIRES_IN=2h
# Refresh Token 有效期
JWT_REFRESH_EXPIRES_IN=7d

# ── LLM ──────────────────────────────
# DeepSeek Key；开启 FEATURE_AI_AGENT 时至少配一个 LLM Key
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# OpenAI（或兼容中转）Key
OPENAI_API_KEY=
# OpenAI 兼容网关地址（可选）
# OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# ── MQ ───────────────────────────────
# 消息驱动：none / rabbitmq / kafka；按预发链路实际依赖设置
MQ_DRIVER=none
# MQ_DRIVER=rabbitmq 时必填
RABBITMQ_URL=
# MQ_DRIVER=kafka 时必填，逗号分隔 broker
KAFKA_BROKERS=
KAFKA_CLIENT_ID=enterprise-admin
KAFKA_GROUP_ID=eas-admin

# ── 功能开关 ─────────────────────────
# AI Agent；开启前确保已配置 LLM Key 与 MONGODB_URI
FEATURE_AI_AGENT=false
# 审计日志
FEATURE_AUDIT_LOG=true
