# 测试环境（NODE_ENV=test）
# 自动化测试 / e2e 使用；密钥用测试值即可
# 校验规则见 src/config/env.schema.ts

# ── 应用 ──────────────────────────────
# 运行环境，须与文件名一致：test
NODE_ENV=test
# HTTP 监听端口
PORT=3000
# 测试进程只绑本机，避免误暴露
HOST=127.0.0.1
# 日志级别；测试压低噪音
LOG_LEVEL=error

# ── MySQL（TypeORM）──────────────────
# 测试库主机
DB_HOST=127.0.0.1
# 测试库端口
DB_PORT=3306
# 测试库用户名
DB_USERNAME=root
# 测试库密码
DB_PASSWORD=
# 独立测试库名，避免污染开发数据
DB_DATABASE=enterprise_admin_test
# 测试连接池可适当调小
DB_POOL_SIZE=5
# 测试禁止自动同步结构；由迁移或测试 setup 准备 schema
DB_SYNC=false
# 不打印 SQL，保持测试输出干净
DB_LOGGING=false

# ── Redis ────────────────────────────
# Redis 主机
REDIS_HOST=127.0.0.1
# Redis 端口
REDIS_PORT=6379
# Redis 密码，无则留空
REDIS_PASSWORD=
# 使用独立逻辑库，与本地开发隔离
REDIS_DB=1
# 测试专用 cache key 前缀
REDIS_PREFIX=eas-test:

# ── MongoDB（LangGraph checkpoint）──
# 测试未启用 AI 时省略
# MONGODB_URI=mongodb://127.0.0.1:27017/eas_checkpoints_test

# ── 认证 ─────────────────────────────
# 测试用短密钥（staging/production 不允许）
JWT_SECRET=test-secret
# 测试 Token 有效期宜短
JWT_EXPIRES_IN=1h
# Refresh Token 测试有效期
JWT_REFRESH_EXPIRES_IN=1d

# ── LLM ──────────────────────────────
# 默认不连真实 LLM；需要联调时再填，并打开 FEATURE_AI_AGENT
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=
# OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# ── MQ ───────────────────────────────
# 测试默认不启 MQ，避免用例依赖中间件
MQ_DRIVER=none
# MQ_DRIVER=rabbitmq 时必填
RABBITMQ_URL=
# MQ_DRIVER=kafka 时必填，逗号分隔
KAFKA_BROKERS=
KAFKA_CLIENT_ID=enterprise-admin-test
KAFKA_GROUP_ID=eas-admin-test

# ── 功能开关 ─────────────────────────
FEATURE_AI_AGENT=false
# 测试通常不写审计，减少断言干扰
FEATURE_AUDIT_LOG=false
